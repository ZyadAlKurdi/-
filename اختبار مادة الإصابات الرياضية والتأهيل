Content-Transfer-Encoding: binary
Content-Location: cid:css-6f2264ee-4c8c-4522-b112-74db71d7e2ba@mhtml.blink

@charset "utf-8";

:root { --primary: #2c3e50; --secondary: #34495e; --wrong: #e74c3c; --correct: #27ae60; --bg: #f4f7f6; --accent: #2980b9; }

body { font-family: Tajawal, sans-serif; background-color: var(--bg); margin: 0px; padding: 20px; }

.quiz-container { background: white; width: 100%; max-width: 900px; padding: 30px; border-radius: 20px; box-shadow: rgba(0, 0, 0, 0.1) 0px 10px 30px; margin: 0px auto; }

h1 { text-align: center; color: var(--primary); border-bottom: 3px solid var(--accent); padding-bottom: 15px; font-size: 24px; }

.home-screen { text-align: center; padding: 20px 0px; }

.university-logo { max-width: 100%; height: auto; max-height: 180px; border-radius: 15px; margin-bottom: 20px; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 10px; }

.home-screen p { font-size: 18px; color: var(--secondary); margin-bottom: 20px; font-weight: bold; }

.sections-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }

.section-card { background: rgb(249, 249, 249); border: 2px solid rgb(238, 238, 238); border-radius: 15px; padding: 20px; transition: 0.3s; }

.section-card:hover { border-color: var(--accent); box-shadow: rgba(41, 128, 185, 0.2) 0px 5px 15px; }

.section-card h3 { color: rgb(107, 33, 92); font-size: 18px; margin-top: 0px; margin-bottom: 15px; }

.card-btns { display: flex; gap: 10px; justify-content: center; }

.btn-main { flex: 1 1 0%; padding: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; font-size: 16px; font-family: Tajawal, sans-serif; font-weight: bold; cursor: pointer; transition: 0.3s; color: white; }

.btn-quiz { background: rgb(107, 33, 92); }

.btn-quiz:hover { background: rgb(74, 21, 64); transform: translateY(-2px); }

.btn-study { background: var(--accent); }

.btn-study:hover { background: rgb(31, 97, 141); transform: translateY(-2px); }

.stats { display: flex; justify-content: space-between; align-items: center; background: rgb(238, 238, 238); padding: 15px 20px; border-radius: 10px; margin-bottom: 20px; font-weight: bold; font-size: 16px; }

.question { font-size: 19px; color: var(--secondary); line-height: 1.6; margin-bottom: 25px; border-right: 5px solid var(--accent); padding-right: 15px; }

.options { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

button.option { padding: 15px; border: 2px solid rgb(221, 221, 221); border-radius: 12px; background: rgb(255, 255, 255); cursor: pointer; transition: 0.3s; font-family: Tajawal; font-size: 16px; text-align: right; display: flex; align-items: center; }

button.option:hover:not([disabled]) { border-color: var(--accent); background: rgb(249, 249, 249); }

button.correct { color: white; border-color: rgb(30, 132, 73); background: var(--correct) !important; }

button.wrong { color: white; border-color: rgb(169, 50, 38); background: var(--wrong) !important; }

#quiz-box, #result-box, #study-box { display: none; }

.study-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--accent); padding-bottom: 10px; margin-bottom: 20px; }

.study-item { background: rgb(255, 255, 255); border: 1px solid rgb(221, 221, 221); padding: 15px; margin-bottom: 15px; border-radius: 10px; text-align: right; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 5px; }

.study-item h4 { margin: 0px 0px 10px; color: var(--primary); font-size: 18px; }

.study-item ul { list-style: none; padding: 0px; margin: 0px; }

.study-item li { padding: 8px; margin-bottom: 5px; border-radius: 5px; background: rgb(244, 244, 244); }

.study-correct { color: rgb(21, 87, 36); border: 1px solid rgb(195, 230, 203); font-weight: bold; background: rgb(212, 237, 218) !important; }

.result-screen { text-align: center; }

.final-score { font-size: 40px; color: rgb(107, 33, 92); margin: 20px 0px; }

.btn-action { padding: 12px 25px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 8px; cursor: pointer; font-weight: bold; margin: 5px; transition: 0.3s; font-family: Tajawal; color: white; }

.btn-reload { background: var(--correct); }

.review-section { margin-top: 40px; text-align: right; display: none; }

@media (max-width: 768px) {
  .sections-grid { grid-template-columns: 1fr; }
  .options { grid-template-columns: 1fr; }
  .study-header { flex-direction: column; gap: 10px; }
}
